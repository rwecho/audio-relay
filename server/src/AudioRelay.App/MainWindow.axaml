<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AudioRelay.App"
        xmlns:ctrl="using:AudioRelay.App"
        x:Class="AudioRelay.App.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Audio Relay"
        Width="380" Height="920"
        MinWidth="380" MinHeight="920"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        Background="#050510">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" Margin="32,24,32,28">

        <TextBlock Grid.Row="0"
                   Text="Audio Relay"
                   FontSize="13" FontWeight="Medium"
                   Foreground="#8E8E93"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,6" />

        <ComboBox Grid.Row="1"
                  ItemsSource="{Binding Adapters}"
                  SelectedItem="{Binding SelectedAdapter}"
                  HorizontalAlignment="Center"
                  MinWidth="260"
                  Margin="0,0,0,12"
                  PlaceholderText="选择网卡">
            <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:AdapterCandidate">
                    <TextBlock Text="{Binding Display}" />
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <Border Grid.Row="2"
                Background="White"
                CornerRadius="20"
                Padding="10"
                HorizontalAlignment="Center"
                Margin="0,0,0,10"
                BoxShadow="0 8 24 0 #80000000">
            <Image Name="QrImage" Width="168" Height="168" />
        </Border>

        <ctrl:ParticleView Grid.Row="3"
                           Bass="{Binding Bass}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10" />

        <TextBlock Grid.Row="4"
                   Text="{Binding Status}"
                   FontSize="17" FontWeight="SemiBold"
                   Foreground="White"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,2" />

        <TextBlock Grid.Row="5"
                   Text="{Binding QrPayload}"
                   FontSize="10"
                   Foreground="#636366"
                   HorizontalAlignment="Center"
                   Margin="0,2,0,2" />

        <StackPanel Grid.Row="6" HorizontalAlignment="Center" Margin="0,2,0,12" Spacing="2">
            <TextBlock Text="{Binding StatsSummary}" FontSize="11" Foreground="#AEAEB2" HorizontalAlignment="Center" />
            <ItemsControl ItemsSource="{Binding ClientLines}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <TextBlock Text="{Binding}" FontSize="10" Foreground="#8E8E93" HorizontalAlignment="Center" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
            <TextBlock Text="🔊" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" />
            <Slider Minimum="0" Maximum="1.5" Value="{Binding Volume}"
                    Width="200" TickFrequency="0.1" />
        </StackPanel>

        <ComboBox Grid.Row="8"
                  ItemsSource="{Binding Devices}"
                  SelectedItem="{Binding SelectedDevice}"
                  HorizontalAlignment="Center"
                  MinWidth="240"
                  PlaceholderText="跟随系统默认设备">
            <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:AudioDevices+Device">
                    <TextBlock Text="{Binding Name}" />
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <CheckBox Grid.Row="9"
                  Content="开机自启"
                  IsChecked="{Binding AutoStart}"
                  Foreground="#AEAEB2"
                  FontSize="12"
                  HorizontalAlignment="Center"
                  Margin="0,10,0,0" />

    </Grid>
</Window>
